{
  "name": "wavehaus",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/make-chime.mjs",
    "predev:demo": "node scripts/make-chime.mjs",
    "predev:worker": "node scripts/make-chime.mjs",
    "dev": "node scripts/dev.mjs php",
    "dev:worker": "node scripts/dev.mjs worker",
    "dev:demo": "vite --config app/vite.config.ts --mode demo --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs pages",
    "lint": "tsc --noEmit && tsc --project server-worker/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:api": "node scripts/test-api.mjs",
    "test:php": "node scripts/test-backend.mjs php",
    "test:worker": "node scripts/test-backend.mjs worker",
    "test:media-offload": "node scripts/test-media-offload.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:migrations:worker": "node scripts/test-migrations-worker.mjs",
    "test:journal": "node scripts/test-journal.mjs",
    "test:journal:php": "node scripts/test-journal.mjs php",
    "test:journal:demo": "vitest run --config vitest.journal.config.ts",
    "e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "idb-keyval": "6.3.0",
    "minisearch": "7.2.0",
    "music-metadata": "12.8.1",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
