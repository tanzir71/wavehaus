{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "resolveJsonModule": true, "skipLibCheck": true, "types": ["vite/client"]
  },
  "include": ["app/src", "app/public/runtime"]
}
